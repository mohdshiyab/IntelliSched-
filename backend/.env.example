# ===================================================================
# IntelliSched Backend Environment Variables
# ===================================================================

# Database Connection URL:
# 1. Local SQLite (Default, Zero-Setup, saved to local file timetable.db):
DATABASE_URL=sqlite:///./timetable.db

# 2. Production PostgreSQL (Render, Supabase, Neon, AWS RDS):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/timetable_db

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=*
